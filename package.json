{
  "name": "insert-coin-vim",
  "version": "0.1.0",
  "description": "Insert Coin — a Vim arcade trainer",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:levels": "vitest run src/levels",
    "test:browser": "node scripts/browser-levels.mjs",
    "matrix": "vitest run src/matrix -u",
    "demo": "npm run build && node scripts/demo-gif.mjs"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "gifenc": "^1.0.3",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
