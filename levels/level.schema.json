{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Insert Coin level",
  "description": "One level (SPEC section 7). Checked by `npm run validate:levels`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "chapter",
    "title",
    "concepts",
    "start",
    "target",
    "par",
    "optimal",
    "solutions",
    "hints",
    "author",
    "license"
  ],
  "definitions": {
    "text": {
      "description": "A key of locales/en.json. Never raw text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": { "key": { "type": "string", "minLength": 1 } }
    }
  },
  "properties": {
    "id": {
      "description": "Same as the file name without `.json`.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "chapter": { "type": "integer", "minimum": 0, "maximum": 11 },
    "title": { "$ref": "#/definitions/text" },
    "brief": {
      "description": "What to do, shown above the buffer from the start.",
      "$ref": "#/definitions/text"
    },
    "concepts": {
      "description": "What the level teaches. Review mode brings these back. A new concept goes in this list first, so a typo cannot split one concept in two.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "a-word",
          "append-a",
          "append-line-end",
          "block-insert",
          "count",
          "delete-char",
          "delete-line",
          "dot-repeat",
          "escape",
          "ex-global",
          "ex-move",
          "ex-normal",
          "ex-quit",
          "ex-range",
          "ex-regex",
          "ex-substitute",
          "ex-write",
          "find-char",
          "gn",
          "inner-paren",
          "inner-quote",
          "inner-word",
          "insert-i",
          "insert-line-start",
          "insert-register",
          "insert-register-0",
          "jump-back",
          "line-jump",
          "macro",
          "macro-repeat",
          "match-bracket",
          "motion-b",
          "motion-big-e",
          "motion-big-w",
          "motion-e",
          "motion-first-char",
          "motion-h",
          "motion-j",
          "motion-k",
          "motion-l",
          "motion-line-end",
          "motion-line-start",
          "motion-w",
          "open-line-above",
          "open-line-below",
          "operator-c",
          "operator-d",
          "operator-y",
          "paragraph",
          "put",
          "redo",
          "register-0",
          "repeat-find",
          "search",
          "search-backward",
          "search-next",
          "search-word",
          "till-char",
          "undo",
          "visual",
          "visual-block",
          "visual-line",
          "visual-put"
        ]
      }
    },
    "start": { "type": "string" },
    "target": { "type": "string" },
    "cursor": {
      "description": "Start position, both zero-based. Default: first character.",
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "ch"],
      "properties": {
        "line": { "type": "integer", "minimum": 0 },
        "ch": { "type": "integer", "minimum": 0 }
      }
    },
    "language": { "type": "string" },
    "forbiddenKeys": {
      "description": "Single keys in Vim notation, for example `x` or `<Del>`.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "par": { "type": "integer", "minimum": 1 },
    "optimal": {
      "description": "Key count of the shortest entry of `solutions`.",
      "type": "integer",
      "minimum": 1
    },
    "solutions": {
      "description": "Vim notation. Each one must end on the key that completes the level.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "hints": {
      "type": "array",
      "items": { "$ref": "#/definitions/text" }
    },
    "match": { "enum": ["exact"] },
    "exit": {
      "description": "The level ends when the player runs this Ex command while the buffer equals `target`. Without it, the level ends as soon as the buffer equals `target`.",
      "enum": ["w", "q", "wq", "q!"]
    },
    "author": { "type": "string", "minLength": 1 },
    "license": { "const": "CC-BY-4.0" }
  }
}
